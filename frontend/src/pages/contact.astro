---
import type { PortableTextBlock } from "@portabletext/types";
import HomePage from "../components/HomePage.astro";
import Menu from "../components/Menu.astro";
import Layout from "../layouts/Layout.astro";
import { getContactPage } from "../utils/sanity";
import "../styles/pages/index.css";

const contact = await getContactPage();

function headlineDescription(headline?: string | PortableTextBlock[]) {
  if (!headline) return undefined;
  if (typeof headline === "string") return headline;
  const text = headline
    .flatMap((block) =>
      block._type === "block" && Array.isArray(block.children)
        ? block.children.map((child) => ("text" in child ? child.text : ""))
        : [],
    )
    .join(" ")
    .replace(/\s+/g, " ")
    .trim();
  return text || undefined;
}
---

<Layout title="Contact" description={headlineDescription(contact?.headline)} fullBleed>
  <Menu />
  {
    contact ? (
      <HomePage home={contact} typewriterSessionKey="contact" />
    ) : (
      <p class="home-empty">Publica Contact en el Studio para verla aquí.</p>
    )
  }
</Layout>
