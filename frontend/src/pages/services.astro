---
import Menu from "../components/Menu.astro";
import ServicesPage from "../components/ServicesPage.astro";
import Layout from "../layouts/Layout.astro";
import { getServicesPage } from "../utils/sanity";
import "../styles/pages/us.css";
// En móvil Us y Services van a una sola columna.
import "../styles/pages/services.css";

const page = await getServicesPage();
---

<Layout title="Services" fullBleed>
  <Menu />
  {
    page ? (
      <ServicesPage page={page} />
    ) : (
      <p class="us-empty">Publica Servicios en el Studio para verla aquí.</p>
    )
  }
</Layout>
