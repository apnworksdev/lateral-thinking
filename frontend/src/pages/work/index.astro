---
import Menu from "../../components/Menu.astro";
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../utils/sanity";
import "../../styles/pages/work.css";

const projects = await getProjects();
const listed = Array.from({ length: 4 }, () => projects).flat();
const categories = [
  ...new Map(
    projects
      .flatMap((project) => project.categories ?? [])
      .filter((category) => category.slug && category.title)
      .map((category) => [category.slug, category]),
  ).values(),
];
---

<Layout title="Work" fullBleed>
  <Menu />
  {
    categories.length > 0 && (
      <div class="work__filters bull-5-mono" role="group" aria-label="Categorías">
        <span class="work__filters-label"><span>[</span>filters<span>]</span></span>
        <button type="button" data-filter="all" aria-pressed="true">
          <span class="work__filters-bracket">[</span>
          All
          <span class="work__filters-bracket">]</span>
        </button>
        {categories.map((category) => (
          <button type="button" data-filter={category.slug} aria-pressed="false">
            <span class="work__filters-bracket">[</span>
            {category.title}
            <span class="work__filters-bracket">]</span>
          </button>
        ))}
      </div>
    )
  }
  <section class="work">
    {
      listed.length > 0 ? (
        <ul class="work__list">
          {listed.map((project) => {
            const slugs = (project.categories ?? [])
              .map((category) => category.slug)
              .filter(Boolean)
              .join(" ");
            return (
              <li data-categories={slugs}>
                <a href={`/work/${project.slug}`}>
                  <span class="work__title neu-haas-display--lg">
                    {project.client && <><span class="work__bracket">[</span>{`${project.client}] `}</>}
                    {project.title}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="work__empty">Publica un proyecto en el Studio para verlo aquí.</p>
      )
    }
  </section>
</Layout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const items = [...document.querySelectorAll<HTMLElement>("[data-categories]")];

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((item) => {
        item.setAttribute("aria-pressed", String(item === button));
      });
      items.forEach((item) => {
        const categories = item.dataset.categories?.split(" ").filter(Boolean) ?? [];
        item.hidden = filter !== "all" && !categories.includes(filter ?? "");
      });
    });
  });
</script>
