---
import Menu from "../components/Menu.astro";
import Layout from "../layouts/Layout.astro";
import { urlFor } from "../utils/image";
import { getArchiveProjects } from "../utils/sanity";
import "../styles/pages/archive.css";
// El hover, la posición, las columnas y los tamaños del archivo se incrustan con esta página.

const projects = await getArchiveProjects();
const listed = Array.from({ length: 10 }, () => projects).flat();
const categories = [
  ...new Map(
    projects
      .flatMap((project) => project.categories ?? [])
      .filter((category) => category.slug && category.title)
      .map((category) => [category.slug, category]),
  ).values(),
];

function formatDate(value?: string) {
  const [year, month, day] = value?.slice(0, 10).split("-") ?? [];
  if (!year || !month || !day) return null;
  return { day, month, year };
}
---

<Layout title="Archive" fullBleed>
  <Menu />
  {
    categories.length > 0 && (
      <div class="archive__filters bull-5-mono" role="group" aria-label="Categorías">
        <span class="archive__filters-label"><span>[</span>filters<span>]</span></span>
        <button type="button" data-filter="all" aria-pressed="true">
          <span class="archive__filters-bracket">[</span>
          All
          <span class="archive__filters-bracket">]</span>
        </button>
        {categories.map((category) => (
          <button type="button" data-filter={category.slug} aria-pressed="false">
            <span class="archive__filters-bracket">[</span>
            {category.title}
            <span class="archive__filters-bracket">]</span>
          </button>
        ))}
      </div>
    )
  }
  <section class="archive">
    {
      listed.length > 0 ? (
        <ul class="archive__list">
          {listed.map((project) => {
            const date = formatDate(project.date);
            const projectServices = (project.services ?? []).filter(Boolean);
            const image = project.mainImage?.asset
              ? urlFor(project.mainImage).width(1600).auto("format").quality(80).url()
              : undefined;
            return (
              <li
                class="archive__item"
                data-categories={(project.categories ?? [])
                  .map((category) => category.slug)
                  .filter(Boolean)
                  .join(" ")}
              >
                <div class="archive__line bull-5-mono uppercase">
                  <span class="archive__hit" aria-hidden="true"></span>
                  {date && (
                    <div class="archive__field archive__date">
                      <span class="archive__field-text"><span class="archive__date-rest">{date.day} {date.month} </span>{date.year}</span>
                    </div>
                  )}
                  {project.location && (
                    <div class="archive__field archive__location">
                      <span class="archive__field-text">{project.location}</span>
                    </div>
                  )}
                  {project.client && (
                    <div class="archive__field archive__client">
                      <span class="archive__field-text"><span class="archive__bracket">[</span>{project.client}]</span>
                    </div>
                  )}
                  {project.title && (
                    <div class="archive__field archive__title">
                      <span class="archive__field-text">{project.title}</span>
                    </div>
                  )}
                  {projectServices.length > 0 && (
                    <div class="archive__field archive__services">
                      <span class="archive__field-text">{projectServices.join(", ")}</span>
                    </div>
                  )}
                </div>
                {image && <img class="archive__hover" src={image} alt={project.mainImage?.alt || ""} />}
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="archive__empty">Publica un proyecto en Archivo para verlo aquí.</p>
      )
    }
  </section>
</Layout>

<script>
  import { typewriteText } from "../scripts/typewriter";

  let resizeArchive = () => {};

  const mobileArchive = () => window.matchMedia("(max-width: 1023px)").matches;
  const typewriters = new Map<HTMLElement, { start: () => void; stop: () => void }>();

  function initArchive() {
    const root = document.querySelector(".archive");
    if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const buttons = [...document.querySelectorAll<HTMLButtonElement>(".archive__filters [data-filter]")];
    const items = [...document.querySelectorAll<HTMLElement>(".archive [data-categories]")];

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((item) => {
        item.setAttribute("aria-pressed", String(item === button));
      });
      items.forEach((item) => {
        const categories = item.dataset.categories?.split(" ").filter(Boolean) ?? [];
        item.hidden = filter !== "all" && !categories.includes(filter ?? "");
      });
    });
  });

  const texts = [...document.querySelectorAll<HTMLElement>(".archive__field-text")];

  texts.forEach((text) => {
    if (text.querySelector(".archive__field-copy")) return;
    const copy = document.createElement("span");
    copy.className = "archive__field-copy";
    while (text.firstChild) copy.append(text.firstChild);
    const loop = copy.cloneNode(true) as HTMLElement;
    loop.setAttribute("aria-hidden", "true");
    text.append(copy, loop);
  });

  function markClipped() {
    texts.forEach((text) => {
      const field = text.parentElement;
      if (!field) return;
      const shift = text.scrollWidth - text.clientWidth;
      if (shift > 1) {
        field.classList.add("is-clipped");
        text.style.setProperty("--archive-duration", `${Math.max(6, text.scrollWidth / 28)}s`);
      } else {
        field.classList.remove("is-clipped");
        text.style.removeProperty("--archive-duration");
      }
    });
  }

  markClipped();
    sizeHits();
    resizeArchive = () => {
      markClipped();
      sizeHits();
      if (!mobileArchive()) return;
      typewriters.forEach((typing) => typing.stop());
      document.querySelectorAll<HTMLImageElement>(".archive__hover").forEach((image) => {
        image.style.left = "";
        image.style.top = "";
        image.style.width = "";
      });
    };

  function sizeHits() {
    document.querySelectorAll<HTMLElement>(".archive__line").forEach((line) => {
      const hit = line.querySelector<HTMLElement>(".archive__hit");
      if (!hit) return;
      const fields = [...line.querySelectorAll<HTMLElement>(".archive__field")].filter(
        (field) => field.getClientRects().length,
      );
      if (!fields.length) {
        hit.style.width = "0px";
        return;
      }
      const right = Math.max(...fields.map((field) => field.getBoundingClientRect().right));
      hit.style.width = `${Math.max(0, right - line.getBoundingClientRect().left)}px`;
    });
  }

  const margin = 20;

  function placeImage(image: HTMLImageElement) {
    const filters = document.querySelector(".archive__filters");
    const textRight = Math.max(
      0,
      ...[...document.querySelectorAll<HTMLElement>(".archive__field")]
        .filter((field) => !field.closest("[hidden]") && field.getClientRects().length)
        .map((field) => field.getBoundingClientRect().right),
    );
    const limitRight = filters ? filters.getBoundingClientRect().left : window.innerWidth;
    const minX = textRight + margin;
    const available = limitRight - margin - minX;
    const natural = Math.min(window.innerWidth * 0.25, 320);
    const width = Math.max(80, Math.min(natural, available));
    image.style.width = `${width}px`;
    const height = image.offsetHeight || width * 0.7;
    const minY = margin;
    const maxY = Math.max(minY, window.innerHeight - margin - height);
    const x = minX + Math.random() * Math.max(0, available - width);
    const y = minY + Math.random() * (maxY - minY);
    image.style.left = `${x}px`;
    image.style.top = `${y}px`;
  }

  let activeImage: HTMLImageElement | null = null;

  document.querySelectorAll<HTMLElement>(".archive__item").forEach((item) => {
    const image = item.querySelector<HTMLImageElement>(".archive__hover");

    item.querySelectorAll<HTMLElement>(".archive__field, .archive__hit").forEach((field) => {
      field.addEventListener("click", () => {
        if (!mobileArchive()) return;
        const open = item.classList.contains("is-open");
        document.querySelectorAll(".archive__item.is-open").forEach((other) => {
          other.classList.remove("is-open");
        });
        if (image) {
          image.style.left = "";
          image.style.top = "";
          image.style.width = "";
        }
        if (!open) item.classList.add("is-open");
      });
      if (!image) return;
      field.addEventListener("pointerenter", () => {
        if (mobileArchive() || activeImage === image) return;
        activeImage = image;
        placeImage(image);
      });
      field.addEventListener("pointerleave", (event) => {
        const next = (event.relatedTarget as Element | null)?.closest?.(".archive__field, .archive__hit");
        if (next && item.contains(next)) return;
        if (activeImage === image) activeImage = null;
      });
    });
    });

    bindArchiveType();
  }

  function bindArchiveType() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    document.querySelectorAll<HTMLElement>(".archive__line").forEach((line) => {
      if (line.dataset.typed === "bound") return;
      line.dataset.typed = "bound";
      let run = 0;
      let active = false;
      let typing: AbortController | null = null;

      const copies = () =>
        [...line.querySelectorAll<HTMLElement>(".archive__field-copy:not([aria-hidden='true'])")];

      const stop = () => {
        run += 1;
        active = false;
        typing?.abort();
        typing = null;
        line.querySelectorAll(".home__type").forEach((layer) => layer.remove());
        line.querySelectorAll(".is-typing").forEach((node) => node.classList.remove("is-typing"));
      };

      const start = () => {
        if (mobileArchive() || active) return;
        const nodes = copies();
        if (!nodes.length) return;
        active = true;
        const token = ++run;
        typing = new AbortController();
        const signal = typing.signal;
        nodes.forEach((node) => node.classList.add("is-typing"));
        void Promise.all(nodes.map((node) => typewriteText(node, signal))).then(() => {
          if (token === run) typing = null;
        });
      };

      typewriters.set(line, { start, stop });

      line.querySelectorAll<HTMLElement>(".archive__field, .archive__hit").forEach((field) => {
        field.addEventListener("pointerenter", () => {
          if (mobileArchive()) return;
          start();
        });
        field.addEventListener("pointerleave", (event) => {
          if (mobileArchive()) return;
          const next = (event.relatedTarget as Element | null)?.closest?.(".archive__line");
          if (next === line) return;
          stop();
        });
      });
    });
  }

  initArchive();
  document.addEventListener("astro:page-load", initArchive);
  window.addEventListener("resize", () => resizeArchive());
</script>
