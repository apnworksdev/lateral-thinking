<script>
  function initConstellation() {
  const scenes = document.querySelectorAll("[data-us-scene]");

  scenes.forEach((scene) => {
    if (scene.closest("[data-intro]") || scene.hasAttribute("data-constellation")) return;
    scene.setAttribute("data-constellation", "");

    const svg = scene.querySelector(".us__lines");
    const node = scene.querySelector("[data-us-node]");
    const items = [...scene.querySelectorAll(".us__gallery li")];
    if (!(svg instanceof SVGSVGElement) || !(node instanceof HTMLElement) || items.length === 0) return;

    const lines = items.map(() => {
      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
      svg.appendChild(line);
      return line;
    });

    const motion = items.map((_, i) => ({
      phase: i * 1.37,
      ax: 16 + (i % 5) * 3,
      ay: 12 + (i % 4) * 4,
      sx: 0.45 + (i % 3) * 0.12,
      sy: 0.32 + (i % 4) * 0.09,
    }));

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const screenMargin = 48;
    const menuGap = 32;
    const menu = document.querySelector(".menu");
    let placedKey = "";
    let energy = 1;
    let clock = 0;
    let last = performance.now();
    let pointerX: number | null = null;
    let pointerY: number | null = null;

    const rightEdge = () => {
      const sceneRect = scene.getBoundingClientRect();
      if (menu instanceof HTMLElement) {
        const menuRect = menu.getBoundingClientRect();
        if (menuRect.width > 0) return menuRect.left - menuGap - sceneRect.left;
      }
      return scene.clientWidth - 96;
    };

    const fitInside = () => {
      const limit = scene.clientHeight - screenMargin;
      const maxRight = rightEdge();
      if (limit <= screenMargin) return;
      const key = `${scene.clientHeight}:${Math.round(maxRight)}:${items.map((item) => `${item.offsetWidth}x${item.offsetHeight}`).join(",")}`;
      if (key === placedKey) return;
      let ready = true;
      items.forEach((item) => {
        const height = item.offsetHeight;
        const width = item.offsetWidth;
        if (height < 2 || width < 2) {
          ready = false;
          return;
        }
        item.style.top = "";
        item.style.left = "";
        const visualTop = item.offsetTop - height / 2;
        let shiftY = 0;
        if (visualTop < screenMargin) shiftY = screenMargin - visualTop;
        const visualBottom = visualTop + height + shiftY;
        if (visualBottom > limit) shiftY -= visualBottom - limit;
        if (Math.abs(shiftY) > 1) {
          const current = parseFloat(getComputedStyle(item).top);
          item.style.top = `${current + shiftY}px`;
        }
        const visualRight = item.offsetLeft + width / 2;
        if (visualRight > maxRight) {
          const current = parseFloat(getComputedStyle(item).left);
          item.style.left = `${current + (maxRight - visualRight)}px`;
        }
      });
      if (ready) placedKey = key;
    };

    const draw = () => {
      const sceneRect = scene.getBoundingClientRect();
      const nodeRect = node.getBoundingClientRect();
      const x1 = nodeRect.left + nodeRect.width / 2 - sceneRect.left;
      const y1 = nodeRect.top + nodeRect.height / 2 - sceneRect.top;

      items.forEach((item, i) => {
        const rect = item.getBoundingClientRect();
        lines[i].setAttribute("x1", String(x1));
        lines[i].setAttribute("y1", String(y1));
        lines[i].setAttribute("x2", String(rect.left - sceneRect.left));
        lines[i].setAttribute("y2", String(rect.top - sceneRect.top));
      });
    };

    if (!reduced) {
      window.addEventListener("pointermove", (event) => {
        if (pointerX !== null && pointerY !== null) {
          const dist = Math.hypot(event.clientX - pointerX, event.clientY - pointerY);
          energy = Math.min(7, energy + dist * 0.02);
        }
        pointerX = event.clientX;
        pointerY = event.clientY;
      });
    }

    const tick = (now: number) => {
      fitInside();
      if (!reduced) {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        energy += (1 - energy) * 0.025;
        clock += dt * energy;
        const limit = scene.clientHeight - screenMargin;
        const maxRight = rightEdge();
        items.forEach((item, i) => {
          const m = motion[i];
          let dx = Math.sin(clock * m.sx + m.phase) * m.ax;
          let dy = Math.cos(clock * m.sy + m.phase * 1.3) * m.ay;
          const height = item.offsetHeight;
          const width = item.offsetWidth;
          if (height >= 2 && limit > screenMargin) {
            const base = item.offsetTop - height / 2;
            dy = Math.min(limit - (base + height), Math.max(screenMargin - base, dy));
          }
          if (width >= 2) {
            const baseRight = item.offsetLeft + width / 2;
            dx = Math.min(maxRight - baseRight, dx);
          }
          item.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
        });
      }
      draw();
      if (!reduced) requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
    if (reduced) window.addEventListener("resize", draw);
  });
  }

  initConstellation();
  document.addEventListener("astro:page-load", initConstellation);
</script>
