---
import { PortableText } from "astro-portabletext";
import { createDataAttribute } from "@sanity/visual-editing-csm";
import HeadlineText from "./HeadlineText.astro";
import TextLink from "./TextLink.astro";
import { urlFor } from "../utils/image";
import type { HomePage } from "../utils/sanity";
import { vimeoPlayerUrl } from "../utils/vimeo";

interface Props {
  home: HomePage;
  /** Si se pasa, el typewriter del headline solo corre una vez por sesión. */
  typewriterSessionKey?: string;
  /** Homepage (/): oculta el banner lateral. */
  landing?: boolean;
}

const { home, typewriterSessionKey, landing = false } = Astro.props;

const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true";

const dataAttr = visualEditingEnabled
  ? createDataAttribute({
      projectId: import.meta.env.PUBLIC_SANITY_STUDIO_PROJECT_ID,
      dataset: import.meta.env.PUBLIC_SANITY_STUDIO_DATASET,
      baseUrl: import.meta.env.PUBLIC_SANITY_STUDIO_URL || "http://localhost:3333",
      id: home._id,
      type: home._type,
    })
  : null;

const imageUrl = home.image?.asset
  ? urlFor(home.image).width(2000).height(1200).fit("crop").auto("format").quality(80).url()
  : undefined;
const mobileImageUrl = home.mobileImage?.asset
  ? urlFor(home.mobileImage).width(900).height(1600).fit("crop").auto("format").quality(80).url()
  : undefined;
const vimeoSrc = home.backgroundType === "vimeo" ? vimeoPlayerUrl(home.vimeoUrl) : undefined;
---

<section class:list={["home", landing && "home--landing"]} data-typewriter-session={typewriterSessionKey}>
  <style is:inline>
    .home__headline.is-typing,
    .home__secondary.is-typing,
    .home__highlight.is-typing {
      color: transparent !important;
      -webkit-text-fill-color: transparent !important;
    }
    .home__secondary.is-typing,
    .home__highlight.is-typing {
      background: none !important;
      background-color: transparent !important;
    }
    .home__headline.is-typing > :not(.home__type),
    .home__secondary.is-typing > :not(.home__type),
    .home__highlight.is-typing > :not(.home__type) {
      color: transparent !important;
      -webkit-text-fill-color: transparent !important;
      background: none !important;
    }
    .home__meta.is-pending {
      opacity: 0 !important;
      visibility: hidden !important;
    }
  </style>
  {
    typewriterSessionKey && (
      <script is:inline>
        (function () {
          var root = document.currentScript && document.currentScript.parentElement;
          if (!root) return;
          var key = root.getAttribute("data-typewriter-session");
          if (!key) return;
          try {
            if (sessionStorage.getItem("lt-typewriter-" + key) === "1") {
              root
                .querySelectorAll(".home__headline.is-typing, .home__secondary.is-typing, .home__highlight.is-typing")
                .forEach(function (el) {
                  el.classList.remove("is-typing");
                });
              root.querySelectorAll(".home__meta.is-pending").forEach(function (el) {
                el.classList.remove("is-pending");
              });
            }
          } catch (e) {}
        })();
      </script>
    )
  }
  {
    home.backgroundType === "image" && imageUrl && (
      <img
        class:list={["home__media", mobileImageUrl && "home__media--desktop"]}
        src={imageUrl}
        alt={home.image?.alt || ""}
        data-sanity={dataAttr?.scope("image").toString()}
      />
    )
  }
  {
    home.backgroundType === "image" && mobileImageUrl && (
      <img
        class="home__media home__media--mobile"
        src={mobileImageUrl}
        alt={home.mobileImage?.alt || home.image?.alt || ""}
        data-sanity={dataAttr?.scope("mobileImage").toString()}
      />
    )
  }
  {
    home.backgroundType === "file" && home.videoUrl && (
      <video
        class="home__media"
        src={home.videoUrl}
        autoplay
        muted
        loop
        playsinline
        data-sanity={dataAttr?.scope("videoFile").toString()}
      />
    )
  }
  {
    home.backgroundType === "vimeo" && vimeoSrc && (
      <iframe
        class="home__vimeo"
        src={vimeoSrc}
        title="Vídeo de fondo"
        allow="autoplay; fullscreen"
        data-sanity={dataAttr?.scope("vimeoUrl").toString()}
      />
    )
  }

  <div class="home__veil"></div>

  <div class="home__content">
    {
      home.headline && (
        <h1 class="home__headline is-typing neu-haas-display" data-sanity={dataAttr?.scope("headline").toString()}>
          {Array.isArray(home.headline) ? (
            <PortableText
              value={home.headline}
              components={{ block: { normal: HeadlineText }, mark: { link: TextLink } }}
            />
          ) : (
            <span>{home.headline}</span>
          )}
        </h1>
      )
    }
    {
      (home.secondaryText || home.highlight) && (
        <div class="home__meta bull-5-mono is-pending">
          {home.secondaryText && (
            <p class="home__secondary is-typing" data-sanity={dataAttr?.scope("secondaryText").toString()}>
              {home.secondaryText}
            </p>
          )}
          {home.highlight && (
            <p class="home__highlight is-typing" data-sanity={dataAttr?.scope("highlight").toString()}>
              {home.highlight}
            </p>
          )}
        </div>
      )
    }
  </div>
</section>

<script>
  import { bindTypewriterSequence } from "../scripts/typewriter";

  bindTypewriterSequence(".home__headline, .home__secondary, .home__highlight", {
    oncePerSession: true,
  });
</script>
