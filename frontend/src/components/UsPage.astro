---
import { PortableText } from "astro-portabletext";
import { createDataAttribute } from "@sanity/visual-editing-csm";
import Constellation from "./Constellation.astro";
import ContactForm from "./ContactForm.astro";
import FormOpen from "./FormOpen.astro";
import TextLink from "./TextLink.astro";
import UsParagraph from "./UsParagraph.astro";
import { urlFor } from "../utils/image";
import type { UsPage } from "../utils/sanity";

interface Props {
  page: UsPage;
}

const { page } = Astro.props;

const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true";

const dataAttr = visualEditingEnabled
  ? createDataAttribute({
      projectId: import.meta.env.PUBLIC_SANITY_STUDIO_PROJECT_ID,
      dataset: import.meta.env.PUBLIC_SANITY_STUDIO_DATASET,
      baseUrl: import.meta.env.PUBLIC_SANITY_STUDIO_URL || "http://localhost:3333",
      id: page._id,
      type: page._type,
    })
  : null;

const slots = [
  { x: 28, y: 16, w: 150 },
  { x: 42, y: 7, w: 96 },
  { x: 56, y: 11, w: 124 },
  { x: 82, y: 14, w: 196 },
  { x: 52, y: 30, w: 156 },
  { x: 32, y: 38, w: 132 },
  { x: 66, y: 42, w: 148 },
  { x: 88, y: 36, w: 108 },
  { x: 72, y: 56, w: 164 },
  { x: 90, y: 64, w: 136 },
  { x: 46, y: 60, w: 154 },
  { x: 26, y: 74, w: 124 },
  { x: 70, y: 76, w: 200 },
  { x: 36, y: 90, w: 176 },
  { x: 74, y: 92, w: 210 },
];

function place(index: number) {
  const slot = slots[index];
  if (slot) return slot;
  const n = index - slots.length;
  const angle = -1.1 + n * 0.65;
  return {
    x: Math.min(88, Math.max(24, 58 + Math.cos(angle) * 26)),
    y: Math.min(90, Math.max(12, 50 + Math.sin(angle) * 38)),
    w: 140,
  };
}

const images = (page.images ?? []).flatMap((image) => {
  if (!image.asset) return [];
  return [
    {
      key: image.asset._ref,
      alt: image.alt || "",
      src: urlFor(image).width(800).auto("format").quality(80).url(),
    },
  ];
});
---

<section class="us">
  {
    images.length > 0 && (
      <div class="us__scene" data-us-scene>
        <svg class="us__lines" aria-hidden="true"></svg>
        <div class="us__node" data-us-node aria-hidden="true"></div>
        <div class="us__node us__node--small" aria-hidden="true"></div>
        <ul class="us__gallery" data-sanity={dataAttr?.scope("images").toString()}>
          {images.map((image, index) => {
            const spot = place(index);
            return (
              <li style={`--x: ${spot.x}%; --y: ${spot.y}%; --w: ${spot.w}px`}>
                <img src={image.src} alt={image.alt} />
              </li>
            );
          })}
        </ul>
      </div>
    )
  }

  {
    page.sections && page.sections.length > 0 && (
      <div class="us__sections" data-sanity={dataAttr?.scope("sections").toString()}>
        {page.sections.map((section) => (
          <article class="us__section">
            {section.title && (
              <h2 class="us__title is-typing bull-5-mono" data-typewriter-desktop>
                {section.title}
              </h2>
            )}
            {section.text && (
              <div class="us__text is-typing neu-haas-display" data-typewriter-desktop>
                <PortableText
                  value={section.text}
                  components={{
                    block: { normal: UsParagraph },
                    mark: { link: TextLink, form: FormOpen },
                  }}
                />
              </div>
            )}
          </article>
        ))}
        <ContactForm title={page.formTitle} sanity={dataAttr?.scope("formTitle").toString()} />
      </div>
    )
  }
  <Constellation />
</section>

<script is:inline>
  if (window.matchMedia("(max-width: 1023px)").matches) {
    document.querySelectorAll("[data-typewriter-desktop]").forEach((node) => {
      node.classList.remove("is-typing");
      node.querySelector(".home__type")?.remove();
    });
  }
</script>
<script>
  import { bindTypewriterSequence } from "../scripts/typewriter";

  bindTypewriterSequence(".us__title, .us__text", { desktopOnly: true, skipOnClick: true });
</script>
